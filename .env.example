# Root Operator Configuration
# Copy this file to .env and customize as needed
# Do not store Apple notarization credentials in this file.
# APPLE_ID / APPLE_APP_SPECIFIC_PASSWORD / APPLE_TEAM_ID should be provided
# only as build-time environment variables or CI secrets.

# =============================================================================
# WORKER API CONFIGURATION
# =============================================================================
# Base URL for the Cloudflare Worker API (for custom subdomain management)
WORKER_BASE_URL=https://{{worker.base.url}}

# Domain used for custom subdomains (used by main process)
WORKER_DOMAIN={{worker.domain}}

# Domain for UI display (must match WORKER_DOMAIN, prefixed for Vite)
VITE_WORKER_DOMAIN={{worker.domain}}

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Internal HTTP/WebSocket server port
INTERNAL_PORT=22000

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Vite dev server ports (only used in development mode)
VITE_RENDERER_PORT=5174
VITE_CLIENT_PORT=5175

# =============================================================================
# APP UPDATE FEED / PUBLISH CONFIGURATION
# =============================================================================
# GitHub repository used for auto-update feed metadata and release publishing.
# Override these for staging builds.
UPDATE_REPO_OWNER=hjertefolger
UPDATE_REPO_NAME=Root_Operator

# release | prerelease | draft
UPDATE_RELEASE_TYPE=release

# Keep Git tags like v2.0.1
UPDATE_VPREFIXED_TAG_NAME=true

# Set to true only if you intentionally use a private GitHub repo for updates.
# Private GitHub update feeds require GH_TOKEN on the client machine.
UPDATE_PRIVATE=false
