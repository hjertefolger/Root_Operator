{
  "name": "root-operator",
  "productName": "Root_Operator",
  "version": "2.4.5",
  "description": "Personal AI assistant for macOS powered by Claude Code channels",
  "main": "main.js",
  "scripts": {
    "dev:client": "vite --config vite.client.config.js",
    "dev:renderer": "vite --config vite.renderer.config.js",
    "dev:app": "npm run build:native && concurrently -k \"npm run dev:renderer\" \"npm run dev:client\" \"wait-on http://localhost:5174/renderer.html && electron .\"",
    "build:runtime-config": "node scripts/build-runtime-config.js",
    "build:native": "node scripts/build-native-helpers.js",
    "build:client": "vite build --config vite.client.config.js",
    "build:renderer": "vite build --config vite.renderer.config.js",
    "build:bridge": "npx esbuild channel-bridge.cjs --bundle --platform=node --target=node18 --outfile=channel-bridge.bundle.cjs --format=cjs --external:net --external:fs",
    "build:all": "npm run build:runtime-config && npm run build:native && npm run build:client && npm run build:renderer && npm run build:bridge",
    "prebuild": "npm run security:audit && npm run build:all",
    "prebuild:unsigned": "npm run security:audit && npm run build:all",
    "prerelease": "npm run security:audit && npm run build:all",
    "start": "electron .",
    "build": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer electron-builder --config build/electron-builder.config.js --mac",
    "build:staging": "node scripts/run-staging.js build",
    "release": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer electron-builder --config build/electron-builder.config.js --mac --publish always",
    "build:unsigned": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer electron-builder --config build/electron-builder.config.js --mac -c.mac.identity=null",
    "build:unsigned:staging": "node scripts/run-staging.js build:unsigned",
    "release:staging": "node scripts/run-staging.js release",
    "rebuild": "electron-rebuild -f -w node-pty keytar better-sqlite3",
    "postinstall": "electron-rebuild -f -w node-pty keytar better-sqlite3",
    "_note:rebuild": "onnxruntime-node intentionally NOT in rebuild list — ships prebuilt N-API v3 binaries for darwin/arm64 (the only arch we publish), no source build needed.",
    "_note:arch": "Apple Silicon only as of v2.4.4. Drop reasoning: Apple stopped selling Intel Macs in mid-2023; macOS 26 (Tahoe) drops Intel later in 2026; native deps (onnxruntime, cloudflared, etc.) increasingly ship arm64-first prebuilds. Maintaining the x64 lane was a permanent multi-arch packaging tax for one known Intel user. To re-enable: add 'x64' back to the arch arrays AND fix the multi-arch packaging path for native binaries (cloudflared install, onnxruntime-node x64 prebuild).",
    "test": "node --test src/orphan-kill.test.js src/scheduler.test.js src/channel-mode.test.js src/claude-lifecycle.test.js src/tray.test.js src/tunnel.test.js src/websocket-bridge.test.js src/crypto-pairing.test.js src/cursor-companion.test.js src/cursor-companion-controller.test.js src/agent-avatar.test.js src/agent-actions.test.js",
    "security:audit": "npm audit --audit-level=critical",
    "security:audit:fix": "npm audit fix",
    "security:check": "npm audit && echo '✅ No known vulnerabilities'"
  },
  "keywords": [
    "terminal",
    "remote",
    "cloudflare",
    "tunnel"
  ],
  "author": "Tomas Krajcik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjertefolger/Root_Operator.git"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "cloudflared": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "fix-path": "^5.0.0",
    "geist": "^1.5.1",
    "input-otp": "^1.4.2",
    "is-electron": "^2.2.2",
    "keytar": "^7.9.0",
    "lucide-react": "^0.562.0",
    "node-cron": "^4.2.1",
    "node-pty": "^1.1.0",
    "phosphor-icons": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "uiohook-napi": "^1.5.5",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zustand": "^5.0.9"
  },
  "overrides": {
    "axios": ">=1.15.0",
    "isbinaryfile": "^5.0.7"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^3.7.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.1",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "vite": "^7.3.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.hjertefolger.rootoperator",
    "productName": "Root_Operator",
    "copyright": "Copyright © 2026 Tomas Krajcik",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/root-operator-macos.icon",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "Hjertefolger s.r.o. (4NF8ZKZ492)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "sign": true
    },
    "icon": "public/icon-512-v3.png",
    "files": [
      "main.js",
      "preload.js",
      "runtime-config.json",
      "channel-bridge.bundle.cjs",
      "claude-stop-hook.cjs",
      "src/channel-manager.js",
      "src/chat-store.js",
      "src/outbound-attachments.js",
      "src/scheduler.js",
      "src/workspace.js",
      "src/updater.js",
      "src/dynamic-memory/**/*",
      "src/main/**/*",
      "src/orphan-kill.js",
      "tray_*.png",
      "ui/**/*",
      "public/dist/**/*",
      "public/fonts/**/*",
      "public/icon-*.png",
      "workspace-templates/**/*",
      "!public/src",
      "node_modules/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "channel-bridge.bundle.cjs",
      "claude-stop-hook.cjs",
      "workspace-templates/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/keytar/**/*",
      "node_modules/cloudflared/**/*",
      "node_modules/uiohook-napi/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/onnxruntime-node/**/*"
    ],
    "extraResources": [
      {
        "from": "build/native/cursor-pointer-tap",
        "to": "cursor-pointer-tap"
      },
      {
        "from": "build/native/ax-helper",
        "to": "ax-helper"
      },
      {
        "from": "models/nomic-embed-text-v1.5",
        "to": "nomic-embed-text-v1.5",
        "filter": [
          "**/*"
        ]
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "afterSign": "scripts/notarize.js"
  }
}
